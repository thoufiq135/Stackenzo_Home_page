{
  "name": "stackenzo",
  "version": "1.0.0",
  "description": "Backend API for Stackenzo Education Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:backend": "nodemon server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\"",
    "init-db": "node backend/src/config/initDatabase.js",
    "build": "cd client && npm run build",
    "clean": "rimraf node_modules package-lock.json"
  },
  "keywords": [
    "education",
    "api",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Stackenzo",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.23.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}